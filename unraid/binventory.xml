<?xml version="1.0"?>
<Container version="2">
  <Name>binventory</Name>
  <Repository>ghcr.io/rickxxrolling/binventory:latest</Repository>
  <Registry>https://github.com/RICKxxROLLING/binventory/pkgs/container/binventory</Registry>
  <Support>https://github.com/RICKxxROLLING/binventory/issues</Support>
  <Project>https://github.com/RICKxxROLLING/binventory</Project>
  <TemplateURL>https://raw.githubusercontent.com/RICKxxROLLING/binventory/main/unraid/binventory.xml</TemplateURL>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Overview>Storage bin inventory. Track what's in each bin (items, photos, rack/shelf location) from your phone and print 4x6 labels with QR codes that open the bin's contents.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>https://raw.githubusercontent.com/RICKxxROLLING/binventory/main/public/icon.png</Icon>
  <Config Name="Web UI Port" Target="8080" Default="8080" Mode="tcp" Description="Port for the web interface" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/binventory" Mode="rw" Description="Database and photos" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/binventory</Config>
  <Config Name="BASE_URL" Target="BASE_URL" Default="" Mode="" Description="URL phones use to reach this app, e.g. http://192.168.1.10:8080. Encoded into every QR code." Type="Variable" Display="always" Required="true" Mask="false">http://192.168.1.10:8080</Config>
  <Config Name="BIN_PREFIX" Target="BIN_PREFIX" Default="BIN" Mode="" Description="Prefix for bin codes (BIN-0001)" Type="Variable" Display="always" Required="false" Mask="false">BIN</Config>
  <Config Name="AUTH_USER" Target="AUTH_USER" Default="" Mode="" Description="Optional login username" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="AUTH_PASS" Target="AUTH_PASS" Default="" Mode="" Description="Optional login password" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="TZ" Target="TZ" Default="America/Los_Angeles" Mode="" Description="Timezone" Type="Variable" Display="advanced" Required="false" Mask="false">America/Los_Angeles</Config>
</Container>
